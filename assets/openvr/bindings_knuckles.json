{
  "controller_type": "knuckles",
  "name": "steamvr-mcp skeletons",
  "description": "Hand skeletons for the steamvr-mcp tracked-state reader",
  "bindings": {
    "/actions/main": {
      "skeleton": [
        { "output": "/actions/main/in/skeleton_left", "path": "/user/hand/left/input/skeleton/left" },
        { "output": "/actions/main/in/skeleton_right", "path": "/user/hand/right/input/skeleton/right" }
      ]
    }
  }
}
